{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "cwd", "writes", "network"],
  "properties": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "cwd": { "type": "string", "minLength": 1 },
    "writes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "network": { "type": "boolean" }
  }
}

